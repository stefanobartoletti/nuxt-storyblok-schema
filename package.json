{
  "name": "nuxt-storyblok-schema",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.16.0",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "mkcert": "mkcert -cert-file certs/localhost.pem -key-file certs/localhost-key.pem localhost 127.0.0.1 ::1",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck && pnpm schema:typecheck",
    "schema:typecheck": "tsc --noEmit -p cms/tsconfig.json",
    "schema:push": "storyblok schema push ./cms/src/schemaTypes/index.ts",
    "schema:diff": "storyblok schema push ./cms/src/schemaTypes/index.ts --dry-run",
    "sample-content:pull": "node sample-content/sync.mjs pull",
    "sample-content:push": "node sample-content/sync.mjs push"
  },
  "dependencies": {
    "@nuxt/image": "^2.2.0",
    "@storyblok/nuxt": "^11.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "nuxt": "^4.6.3",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@stefanobartoletti/eslint-config": "^6.3.1",
    "@storyblok/schema": "^0.5.0",
    "eslint": "^10.13.0",
    "storyblok": "4.25.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.13"
  }
}
