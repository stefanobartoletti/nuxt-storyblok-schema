# Settings > Space. Used by `schema:diff`/`schema:push`
STORYBLOK_SPACE_ID="<paste your space ID here>"
# Preview token, from Settings > Access Tokens
STORYBLOK_DELIVERY_API_TOKEN="<paste your preview token here>"
# eu | us | ap | ca | cn
STORYBLOK_REGION="eu"
# draft | published (default: published)
STORYBLOK_VERSION="draft"
